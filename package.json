{
  "name": "nibble",
  "version": "1.0.1",
  "private": true,
  "description": "Save the inspiration. Cook the recipe. A local-first desktop recipe library.",
  "author": "Nibble contributors",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "staging": "node scripts/staging.mjs",
    "build:staging": "node scripts/staging.mjs --build-only",
    "verify:staging": "npm test && npm run test:launchers && npm run test:import:offline && npm run test:ui:offline && npm run test:import:single && npm run build:staging",
    "preview:staging": "node scripts/review-preview.mjs",
    "setup:ocr": "node scripts/prepare-ocr.mjs",
    "test:ocr": "node scripts/ocr-smoke.mjs && node scripts/ocr-regression.mjs",
    "test:desktop": "node scripts/staging-smoke.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "start": "node scripts/start-production.mjs",
    "test": "node scripts/test.mjs",
    "test:watch": "vitest",
    "test:import:offline": "node --test scripts/import-representations.test.mjs",
    "test:launchers": "node --test scripts/staging-launch.test.mjs scripts/production-launch.test.mjs scripts/preview-server.test.mjs scripts/desktop-smoke-result.test.mjs scripts/channel-parity.test.mjs",
    "test:package": "node scripts/verify-package.mjs",
    "typecheck": "tsc --noEmit",
    "package:win": "npm run build && node scripts/package-windows.mjs",
    "package:dir": "npm run build && node scripts/package-windows.mjs --dir",
    "licenses": "node scripts/licenses.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "test:ui:offline": "node --test scripts/ui-workflows.test.mjs",
    "test:import:single": "node --test scripts/single-import.test.mjs",
    "verify:parity": "node scripts/verify-channel-parity.mjs"
  },
  "dependencies": {
    "ipaddr.js": "1.9.1",
    "parse5": "^7.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tesseract.js": "5.1.1",
    "zod": "3.25.76",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "41.10.7",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "build": {
    "appId": "app.nibble.desktop",
    "productName": "Nibble",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release/1.0.1",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist-electron/ocr{,/**/*}",
      "!dist-electron/*.map",
      "assets/**/*",
      "workers/**/*",
      "docs/LICENSES.md",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "workers",
        "to": "workers",
        "filter": [
          "*.py",
          "requirements.txt"
        ]
      },
      {
        "from": "docs",
        "to": "docs",
        "filter": [
          "**/*",
          "!RELEASE_*.md",
          "!TEST_RESULTS.md",
          "!STAGING.md"
        ]
      },
      {
        "from": "dist-electron/ocr",
        "to": "ocr"
      },
      {
        "from": "browser-companion",
        "to": "browser-companion",
        "filter": [
          "manifest.json",
          "capture.js",
          "popup.html",
          "popup.css",
          "popup.js",
          "privacy.html",
          "README.txt",
          "photo-capture.js"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/tesseract.js/**/*",
      "node_modules/tesseract.js-core/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hvo7/Nibble.git"
  },
  "homepage": "https://github.com/hvo7/Nibble#readme",
  "bugs": {
    "url": "https://github.com/hvo7/Nibble/issues"
  },
  "license": "Apache-2.0"
}
